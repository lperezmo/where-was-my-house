# Cloudflare R2, used only by `bun run sync-tiles` to upload the paleo map
# tiles. The site itself needs none of this: it reads tiles from the public
# bucket URL, so nothing here is ever set on Vercel.
#
# Copy this file to .env and paste the real values in. .env is gitignored.
#
#   cp .env.example .env
#
# Where each value comes from in the Cloudflare dashboard:

# R2 > Overview, in the "Account ID" box on the right, or the 32 hex characters
# in the S3 API endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=

# R2 > API > Manage API tokens > Create API token, with Object Read & Write on
# the bucket below. The pair is shown once, so save both now.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The bucket name you created, for example maptiles
R2_BUCKET=

# The bucket's public URL, either the r2.dev subdomain enabled under
# Settings > Public Development URL, or a custom domain. No trailing slash.
# Tiles are then served from <base>/tiles/{age}/{z}/{x}/{y}.png
#
# This one is NOT a secret: the browser fetches tiles directly, so it is visible
# in devtools wherever it is stored. It is an env var so the CDN can be
# repointed without a code change, not for secrecy.
#
# It is the only variable here that also belongs in Vercel. Set it under
# Settings > Environment Variables for Production and Preview. The VITE_ prefix
# is required for Vite to expose it to browser code, and the value is inlined at
# build time, so changing it in Vercel needs a redeploy to take effect.
VITE_TILE_BASE=
